{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    // Vendored registry code (Bklit charts, componentry ui) — updated via `shadcn add`, not hand-edited.
    "includes": [
      "!public",
      "!src/components/charts",
      "!src/lib/utils.ts"
    ]
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "rules": {
      "suspicious": {
        // text-wrap and ::selection are progressive enhancements here.
        "useBaseline": "off"
      }
    }
  },
  "overrides": [
    {
      // React Three Fiber intrinsic elements take three.js props, not DOM attributes.
      "includes": ["src/components/figures/pirin-scene.tsx"],
      "linter": { "rules": { "suspicious": { "noUnknownAttribute": "off" } } }
    }
  ]
}
